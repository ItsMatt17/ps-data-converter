# Template suggestion from https://consultwithgriff.com/base-gitignore

# Node JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# Environment and secrets
.env
.env.local
.env.*.local
*.local.json
appsettings.Development.json
secrets.json

# OS Files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.cache

xml/*
!.gitkeep
